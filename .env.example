# Cadena de conexion a tu PostgreSQL local
DATABASE_URL="postgresql://usuario:password@localhost:5432/nombre_db"

PORT=4000

# Secreto para firmar los tokens JWT. Debe ser largo y aleatorio (minimo 32 caracteres).
# Genera uno con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="cambia_esto_por_el_valor_generado"